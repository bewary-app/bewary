{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "app.bewary/bewary",
  "title": "Bewary: scam, phishing and fraud detection",
  "description": "Threat intelligence for AI agents: checks URLs, domains, phones, emails, wallets and IBANs for scams",
  "version": "1.11.0",
  "websiteUrl": "https://bewary.app/mcp",
  "repository": {
    "url": "https://github.com/bewary-app/bewary",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://bewary.app/brand/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://bewary.app/brand/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.bewary.app/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer and your Bewary API key (a free key gets 1,000 credits a month: https://bewary.app/pricing)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
